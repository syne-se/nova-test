    -- Cancel button
    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Size = UDim2.new(0.3, 0, 0.15, 0)
    cancelBtn.Position = UDim2.new(0.6, 0, 0.75, 0)
    cancelBtn.BackgroundColor3 = config.CancelColor or Color3.new(0.588, 0.196, 0.196)
    cancelBtn.BackgroundTransparency = 0
    cancelBtn.BorderSizePixel = 0
    cancelBtn.Text = config.CancelText or "Cancel"
    cancelBtn.TextColor3 = Color3.new(1, 1, 1)
    cancelBtn.TextSize = config.ButtonSize or 16
    cancelBtn.Font = Enum.Font.GothamBold
    cancelBtn.Parent = alertBox
    
    local cancelCorner = Instance.new("UICorner")
    cancelCorner.CornerRadius = UDim.new(0, 6)
    cancelCorner.Parent = cancelBtn
    
    local function destroyAlert()
        overlay:Destroy()
    end
    
    confirmBtn.MouseButton1Click:Connect(function()
        destroyAlert()
        if callback then
            pcall(callback, true)
        end
    end)
    
    cancelBtn.MouseButton1Click:Connect(function()
        destroyAlert()
        if callback then
            pcall(callback, false)
        end
    end)
    
    return {
        Destroy = destroyAlert,
        ConfirmButton = confirmBtn,
        CancelButton = cancelBtn,
    }
end

-- ============================================
-- EXPOSE TO GLOBAL ENVIRONMENT
-- ============================================
if getgenv then
    getgenv().NovaUI = NovaUI
    getgenv()._NOVA_EXECUTOR = NovaUI
end

-- Return for script use
return NovaUI
