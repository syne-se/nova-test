-- ============================================
-- GUI CONTAINER INITIALIZATION
-- ============================================
local function getPlayerGui()
    if not LocalPlayer then
        warn("[Nexus] No LocalPlayer found, creating ScreenGui on CoreGui")
        return game:GetService("CoreGui")
    end
    
    local success, gui = pcall(function()
        return LocalPlayer:WaitForChild("PlayerGui")
    end)
    
    if success and gui then
        return gui
    end
    
    success, gui = pcall(function()
        return game:GetService("CoreGui")
    end)
    
    if success and gui then
        return gui
    end
    
    return Instance.new("ScreenGui")
end

function Nexus:Init(config)
    if self._initialized then
        return self
    end
    
    config = config or {}
    self._debug = config.Debug or false
    self._safeMode = config.SafeMode or (config.SafeMode == nil and true)
    self._theme = config.Theme or "Dark"
    
    -- Initialize localization if provided
    if config.Localization then
        self:SetupLocalization(config.Localization)
    end
    
    local container = getPlayerGui()
    
    local success, gui = pcall(function()
        local sg = Instance.new("ScreenGui")
        sg.Name = "NexusUI_" .. tostring(math.random(1000, 9999))
        sg.Parent = container
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        return sg
    end)
    
    if success and gui then
        self._frame = gui
    else
        success, gui = pcall(function()
            local sg = Instance.new("ScreenGui")
            sg.Name = "NexusUI"
            sg.Parent = game:GetService("CoreGui")
            sg.ResetOnSpawn = false
            return sg
        end)
        
        if success and gui then
            self._frame = gui
        else
            error("[Nexus] Failed to create ScreenGui")
        end
    end
    
    pcall(function()
        self._frame.Name = "RobloxGui_" .. tostring(math.random(10000, 99999))
    end)
    
    self:_startHeartbeat()
    self._initialized = true
    
    if self._debug then
        print("[Nexus] Initialized successfully - Theme:", self._theme)
        print("[Nexus] Safe Mode:", self._safeMode)
    end
    
    return self
end

-- ============================================
-- LOCALIZATION SYSTEM
-- ============================================
function Nexus:SetupLocalization(config)
    self._localization.enabled = config.Enabled or false
    self._localization.prefix = config.Prefix or "loc:"
    self._localization.defaultLang = config.DefaultLanguage or "en"
    self._localization.currentLang = config.DefaultLanguage or "en"
    self._localization.translations = config.Translations or {}
    
    if self._debug then
        print("[Nexus] Localization setup with", #self._localization.translations, "languages")
    end
end

function Nexus:GetLocalizedText(key, lang)
    if not self._localization.enabled then
        return key
    end
    
    lang = lang or self._localization.currentLang
    local translations = self._localization.translations[lang]
    
    if translations and translations[key] then
        return translations[key]
    end
    
    -- Fallback to default language
    if lang ~= self._localization.defaultLang then
        local defaultTranslations = self._localization.translations[self._localization.defaultLang]
        if defaultTranslations and defaultTranslations[key] then
            return defaultTranslations[key]
        end
    end
    
    if self._debug then
        warn("[Nexus] Localization key not found:", key)
    end
    
    return key
end

function Nexus:SetLanguage(lang)
    if self._localization.translations[lang] then
        self._localization.currentLang = lang
        return true
    end
    return false
end

function Nexus:GetLocalized(key)
    if string.sub(key, 1, 4) == self._localization.prefix then
        local realKey = string.sub(key, 5)
        return self:GetLocalizedText(realKey)
    end
    return key
end

-- ============================================
-- KEY SYSTEM / SERVICES
-- ============================================
function Nexus:RegisterService(serviceName, serviceData)
    self._services[serviceName] = serviceData
    if self._debug then
        print("[Nexus] Service registered:", serviceName)
    end
end

function Nexus:ValidateKey(key, serviceName)
    local service = self._services[serviceName]
    if not service then
        return false, "Service not found"
    end
    
    if service.Validate then
        return service.Validate(key)
    end
    
    return false, "No validation function provided"
end

function Nexus:SetupKeySystem(config)
    self._keySystem.enabled = true
    self._keySystem.providers = config.Providers or {}
    
    if self._debug then
        print("[Nexus] Key system setup with", #self._keySystem.providers, "providers")
    end
end

function Nexus:CheckKey(key, providerName)
    local provider = self._keySystem.providers[providerName]
    if not provider then
        return false, "Provider not found"
    end
    
    local isValid, message = provider.Validate(key)
    if isValid then
        self._keySystem.validated = true
    end
    
    return isValid, message
end

-- ============================================
-- HEARTBEAT LOOP
-- ============================================
function Nexus:_startHeartbeat()
    local heartbeat = RunService.Heartbeat
    
    local function onHeartbeat()
        for i = #self._windows, 1, -1 do
            local window = self._windows[i]
            if not window or not window.Instance or not window.Instance.Parent then
                table.remove(self._windows, i)
            end
        end
        
        for i = #self._notifications, 1, -1 do
            local notif = self._notifications[i]
            if not notif or not notif.Parent then
                table.remove(self._notifications, i)
            end
        end
        
        for i = #self._popups, 1, -1 do
            local popup = self._popups[i]
            if not popup or not popup.Parent then
                table.remove(self._popups, i)
            end
        end
    end
    
    self._eventConnections.Heartbeat = heartbeat:Connect(onHeartbeat)
end

-- ============================================
-- THEME FUNCTIONS
-- ============================================
function Nexus:GetTheme()
    return self._themes[self._theme]
end

function Nexus:SetTheme(themeName)
    if self._themes[themeName] then
        self._theme = themeName
        
        for _, window in ipairs(self._windows) do
            if window and window.UpdateTheme then
                window:UpdateTheme()
            end
        end
        
        if self._debug then
            print("[Nexus] Theme changed to:", themeName)
        end
        
        return true
    end
    
    if self._debug then
        warn("[Nexus] Theme not found:", themeName)
    end
    
    return false
end

function Nexus:GetColor(colorPath)
    local theme = self:GetTheme()
    if not theme then return Color3.new(1, 0, 1) end
    
    local parts = {}
    for part in string.gmatch(colorPath, "[^.]+") do
        table.insert(parts, part)
    end
    
    local current = theme
    for _, part in ipairs(parts) do
        if current[part] then
            current = current[part]
        else
            if self._debug then
                warn("[Nexus] Color path not found:", colorPath)
            end
            return Color3.new(1, 0, 1)
        end
    end
    
    return current
end

-- ============================================
-- UTILITY FUNCTIONS
-- ============================================
function Nexus:CreateCorner(instance, radius)
    if not radius then radius = 4 end
    
    local success, corner = pcall(function()
        local uc = Instance.new("UICorner")
        uc.CornerRadius = UDim.new(0, radius)
        uc.Parent = instance
        return uc
    end)
    
    if success then
        return corner
    end
    
    return nil
end

function Nexus:CreateShadow(instance, size, transparency)
    if not size then size = 16 end
    if not transparency then transparency = 0.5 end
    
    local success, shadow = pcall(function()
        local us = Instance.new("UIShadow")
        us.Color = Color3.fromRGB(0, 0, 0)
        us.Transparency = transparency
        us.Size = size
        us.Parent = instance
        return us
    end)
    
    if success then
        return shadow
    end
    
    return nil
end

function Nexus:GetInstanceFromPool(className)
    local pool = self._instancePool[className]
    if not pool then return nil end
    
    for i = #pool, 1, -1 do
        local instance = pool[i]
        if instance and instance.Parent == nil then
            table.remove(pool, i)
            instance.Visible = true
            return instance
        end
    end
    
    return nil
end

function Nexus:ReturnToPool(instance)
    if not instance then return end
    
    local className = instance.ClassName
    local pool = self._instancePool[className]
    if not pool then return end
    
    instance.Visible = false
    instance.Parent = nil
    table.insert(pool, instance)
end

function Nexus:CreateGradientText(text, startColor, endColor)
    local result = ""
    local len = #text
    if len == 0 then return text end
    
    for i = 1, len do
        local t = (i - 1) / (len - 1)
        local r = math.floor((startColor.R + (endColor.R - startColor.R) * t) * 255)
        local g = math.floor((startColor.G + (endColor.G - startColor.G) * t) * 255)
        local b = math.floor((startColor.B + (endColor.B - startColor.B) * t) * 255)
        result = result .. string.format('<font color="rgb(%d,%d,%d)">%s</font>', r, g, b, text:sub(i, i))
    end
    
    return result
end

-- ============================================
-- ANIMATION ENGINE
-- ============================================
function Nexus:Animate(instance, targetProps, duration, easingStyle, callback)
    if not instance or not targetProps then return end
    
    duration = duration or 0.3
    easingStyle = easingStyle or Enum.EasingStyle.Quad
    
    if TweenService then
        local success, tween = pcall(function()
            local tweenInfo = TweenInfo.new(duration, easingStyle, Enum.EasingDirection.Out)
            local t = TweenService:Create(instance, tweenInfo, targetProps)
            t:Play()
            
            if callback then
                t.Completed:Connect(function()
                    callback()
                end)
            end
            
            return t
        end)
        
        if success and tween then
            return tween
        end
    end
    
    if self._debug then
        warn("[Nexus] TweenService failed, using manual animation")
    end
    
    local startTime = tick()
    local startProps = {}
    
    for prop, targetVal in pairs(targetProps) do
        local success, currentVal = pcall(function()
            return instance[prop]
        end)
        
        if success and currentVal ~= nil then
            startProps[prop] = currentVal
        else
            if self._debug then
                warn("[Nexus] Cannot animate property:", prop)
            end
            return
        end
    end
    
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not self._running then
            if connection then connection:Disconnect() end
            return
        end
        
        local elapsed = (tick() - startTime) / duration
        
        if elapsed >= 1 then
            elapsed = 1
            if connection then connection:Disconnect() end
            
            for prop, targetVal in pairs(targetProps) do
                pcall(function()
                    instance[prop] = targetVal
                end)
            end
            
            if callback then
                callback()
            end
            return
        end
        
        local eased = elapsed * elapsed * (3 - 2 * elapsed)
        
        for prop, startVal in pairs(startProps) do
            local targetVal = targetProps[prop]
            if type(startVal) == "number" and type(targetVal) == "number" then
                pcall(function()
                    instance[prop] = startVal + (targetVal - startVal) * eased
                end)
            end
        end
    end)
    
    return connection
end

-- ============================================
-- COMPONENT CREATION HELPERS
-- ============================================
local function createBaseElement(className, parent, config)
    config = config or {}
    local instance = Instance.new(className)
    instance.Parent = parent or nil
    
    if config.Size then instance.Size = config.Size end
    if config.Position then instance.Position = config.Position end
    if config.BackgroundColor3 then instance.BackgroundColor3 = config.BackgroundColor3 end
    if config.BackgroundTransparency ~= nil then instance.BackgroundTransparency = config.BackgroundTransparency end
    if config.BorderSizePixel ~= nil then instance.BorderSizePixel = config.BorderSizePixel end
    if config.Visible ~= nil then instance.Visible = config.Visible end
    if config.ZIndex then instance.ZIndex = config.ZIndex end
    if config.AnchorPoint then instance.AnchorPoint = config.AnchorPoint end
    if config.ClipsDescendants ~= nil then instance.ClipsDescendants = config.ClipsDescendants end
    
    if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
        if config.Text then instance.Text = config.Text end
        if config.TextColor3 then instance.TextColor3 = config.TextColor3 end
        if config.TextSize then instance.TextSize = config.TextSize end
        if config.Font then instance.Font = config.Font end
        if config.TextXAlignment then instance.TextXAlignment = config.TextXAlignment end
        if config.TextYAlignment then instance.TextYAlignment = config.TextYAlignment end
        if config.TextScaled ~= nil then instance.TextScaled = config.TextScaled end
        if config.PlaceholderText then instance.PlaceholderText = config.PlaceholderText end
        if config.PlaceholderColor3 then instance.PlaceholderColor3 = config.PlaceholderColor3 end
        if config.ClearTextOnFocus ~= nil then instance.ClearTextOnFocus = config.ClearTextOnFocus end
        if config.AutoButtonColor ~= nil then instance.AutoButtonColor = config.AutoButtonColor end
    end
    
    if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
        if config.Image then instance.Image = config.Image end
        if config.ImageColor3 then instance.ImageColor3 = config.ImageColor3 end
        if config.ImageTransparency then instance.ImageTransparency = config.ImageTransparency end
        if config.ScaleType then instance.ScaleType = config.ScaleType end
    end
    
    if instance:IsA("ScrollingFrame") then
        if config.CanvasSize then instance.CanvasSize = config.CanvasSize end
        if config.ScrollBarThickness then instance.ScrollBarThickness = config.ScrollBarThickness end
        if config.VerticalScrollBarPosition then instance.VerticalScrollBarPosition = config.VerticalScrollBarPosition end
    end
    
    return instance
end

