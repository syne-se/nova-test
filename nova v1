-- Add child to parent with automatic positioning
function NovaUI.AddChild(parent, child, position)
    child.Parent = parent
    if position then
        child.Position = position
    end
    return child
end

-- Create a horizontal list
function NovaUI.HorizontalList(parent, spacing, padding)
    spacing = spacing or 10
    padding = padding or 10
    local list = NovaUI.Frame({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
    })
    list.Parent = parent
    
    local children = {}
    local totalWidth = 0
    local maxHeight = 0
    
    local function addChild(child)
        table.insert(children, child)
        child.Parent = list
    end
    
    local function updateLayout()
        local x = padding
        local y = padding
        for _, child in ipairs(children) do
            local size = child.Size
            child.Position = UDim2.new(0, x, 0, y)
            x = x + size.X.Offset + spacing
            if child.Size.Y.Offset > maxHeight then
                maxHeight = child.Size.Y.Offset
            end
        end
        list.Size = UDim2.new(0, x + padding, 0, maxHeight + padding * 2)
    end
    
    return {
        AddChild = addChild,
        Update = updateLayout,
        List = list,
    }
end

-- ============================================
-- TWEEN/ANIMATION SYSTEM
-- ============================================
function NovaUI.Tween(instance, properties, duration, style, direction)
    duration = duration or 0.5
    style = style or Enum.EasingStyle.Quad
    direction = direction or Enum.EasingDirection.Out
    
    local tweenInfo = TweenInfo.new(duration, style, direction)
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

