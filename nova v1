-- BUTTON CREATION
-- ============================================
function Nexus:CreateButton(config)
    config = config or {}
    local theme = self:GetTheme()
    
    local btnText = self:GetLocalized(config.Text or "Button")
    
    local btn = createBaseElement("TextButton", nil, {
        Size = config.Size or UDim2.fromOffset(100, 32),
        Position = config.Position or UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = config.Color or theme.primary,
        BackgroundTransparency = 0,
        Text = btnText,
        TextColor3 = theme.text,
        TextSize = config.TextSize or 14,
        Font = config.Font or Enum.Font.GothamSemibold,
        BorderSizePixel = 0,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        AutoButtonColor = false,
        ZIndex = config.ZIndex or 100
    })
    
    self:CreateCorner(btn, config.Radius or 4)
    
    local isHovered = false
    local isPressed = false
    local originalColor = config.Color or theme.primary
    local hoverColor = config.HoverColor or theme.primaryHover
    local pressedColor = config.PressedColor or theme.primaryPressed
    
    btn.MouseEnter:Connect(function()
        isHovered = true
        if not isPressed then
            btn.BackgroundColor3 = hoverColor
        end
    end)
    
    btn.MouseLeave:Connect(function()
        isHovered = false
        if not isPressed then
            btn.BackgroundColor3 = originalColor
        end
    end)
    
    if config.UsePressEvents ~= false then
        btn.MouseButton1Down:Connect(function()
            isPressed = true
            btn.BackgroundColor3 = pressedColor
        end)
        
        btn.MouseButton1Up:Connect(function()
            isPressed = false
            if isHovered then
                btn.BackgroundColor3 = hoverColor
            else
                btn.BackgroundColor3 = originalColor
            end
        end)
    end
    
    if config.Callback then
        btn.MouseButton1Click:Connect(function(...)
            local success, result = pcall(config.Callback, ...)
            if not success and self._debug then
                warn("[Nexus] Button callback error:", result)
            end
        end)
    end
    
    local buttonData = {
        Instance = btn,
        UpdateTheme = function(self)
            local newTheme = self.Parent and self.Parent:GetTheme() or theme
            btn.TextColor3 = newTheme.text
            if not isHovered and not isPressed then
                btn.BackgroundColor3 = config.Color or newTheme.primary
            end
        end,
        SetText = function(self, text)
            btn.Text = self.Parent and self.Parent.Parent:GetLocalized(text) or text
        end,
        SetEnabled = function(self, enabled)
            btn.Active = enabled
            btn.TextTransparency = enabled and 0 or 0.5
            btn.BackgroundTransparency = enabled and 0 or 0.5
        end
    }
    
    buttonData.Parent = self
    
    return buttonData
end

