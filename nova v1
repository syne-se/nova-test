-- ============================================
-- STATE SYSTEM (Reactive as FUCK)
-- ============================================
function NovaUI.State(initialValue)
    local self = {
        _value = initialValue,
        _listeners = {},
        _boundInstances = {},
    }
    
    setmetatable(self, {
        __index = function(t, k)
            if k == "get" then
                return function() return t._value end
            elseif k == "set" then
                return function(self, newVal)
                    if t._value == newVal then return end
                    t._value = newVal
                    for _, cb in ipairs(t._listeners) do
                        pcall(cb, newVal)
                    end
                    for _, data in ipairs(t._boundInstances) do
                        pcall(function()
                            data.instance[data.prop] = newVal
                        end)
                    end
                end
            elseif k == "bind" then
                return function(instance, prop)
                    table.insert(t._boundInstances, {instance = instance, prop = prop})
                    pcall(function()
                        instance[prop] = t._value
                    end)
                end
            elseif k == "listen" then
                return function(cb)
                    table.insert(t._listeners, cb)
                    pcall(cb, t._value)
                end
            else
                return nil
            end
        end
    })
    
    return self
end

-- ============================================
-- COMPUTED STATE
-- ============================================
function NovaUI.Computed(deps, fn)
    local state = NovaUI.State(fn())
    local function recompute()
        state:set(fn())
    end
    for _, dep in ipairs(deps) do
        dep:listen(recompute)
    end
    return state
end

