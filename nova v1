-- ============================================
-- SAFE SERVICE GETTER (Works on all executors)
-- ============================================
local function getService(serviceName)
    local success, svc = pcall(function()
        return game:GetService(serviceName)
    end)
    if success and svc then
        return svc
    end
    success, svc = pcall(function()
        return game:FindService(serviceName)
    end)
    if success and svc then
        return svc
    end
    success, svc = pcall(function()
        return game:FindFirstChild(serviceName)
    end)
    if success and svc then
        return svc
    end
    return nil
end

