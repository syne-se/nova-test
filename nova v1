-- ============================================
-- SLIDER CREATION
-- ============================================
function Nexus:CreateSlider(config)
    config = config or {}
    local theme = self:GetTheme()
    local min = config.Min or 0
    local max = config.Max or 100
    local value = config.Default or 50
    
    local container = createBaseElement("Frame", nil, {
        Size = config.Size or UDim2.fromOffset(200, 30),
        Position = config.Position or UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = config.ZIndex or 100
    })
    
    local track = createBaseElement("Frame", container, {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 12),
        BackgroundColor3 = theme.bg,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ZIndex = 101
    })
    
    self:CreateCorner(track, 3)
    
    local fill = createBaseElement("Frame", track, {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = theme.primary,
        BorderSizePixel = 0,
        ZIndex = 102
    })
    
    self:CreateCorner(fill, 3)
    
    local handle = createBaseElement("Frame", container, {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new((value - min) / (max - min), -8, 0, 1),
        BackgroundColor3 = theme.primary,
        BorderSizePixel = 0,
        ZIndex = 103
    })
    
    self:CreateCorner(handle, 8)
    
    local valueLabel = createBaseElement("TextLabel", container, {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -45, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = theme.text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 100
    })
    
    local dragging = false
    
    local function updateSlider(inputPos)
        local trackSize = track.AbsoluteSize.X
        if trackSize <= 0 then return end
        
        local relativeX = math.clamp(inputPos.X - track.AbsolutePosition.X, 0, trackSize)
        local percentage = relativeX / trackSize
        value = math.round(min + (max - min) * percentage)
        
        fill.Size = UDim2.new(percentage, 0, 1, 0)
        handle.Position = UDim2.new(percentage, -8, 0, 1)
        valueLabel.Text = tostring(value)
        
        if config.OnChange then
            config.OnChange(value)
        end
    end
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    handle.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input.Position)
        end
    end)
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            updateSlider(input.Position)
        end
    end)
    
    local sliderData = {
        Instance = container,
        UpdateTheme = function(self)
            local newTheme = self.Parent and self.Parent:GetTheme() or theme
            track.BackgroundColor3 = newTheme.bg
            fill.BackgroundColor3 = newTheme.primary
            handle.BackgroundColor3 = newTheme.primary
            valueLabel.TextColor3 = newTheme.text
        end,
        GetValue = function(self)
            return value
        end,
        SetValue = function(self, newValue)
            value = math.clamp(newValue, min, max)
            local percentage = (value - min) / (max - min)
            fill.Size = UDim2.new(percentage, 0, 1, 0)
            handle.Position = UDim2.new(percentage, -8, 0, 1)
            valueLabel.Text = tostring(value)
            if config.OnChange then
                config.OnChange(value)
            end
        end,
        SetMinMax = function(self, newMin, newMax)
            min = newMin or min
            max = newMax or max
            self:SetValue(math.clamp(value, min, max))
        end
    }
    
    sliderData.Parent = self
    
    return sliderData
end

-- ============================================
-- DROPDOWN CREATION
-- ============================================
function Nexus:CreateDropdown(config)
    config = config or {}
    local theme = self:GetTheme()
    local options = config.Options or {}
    local selected = config.Default or options[1] or ""
    
    local container = createBaseElement("Frame", nil, {
        Size = config.Size or UDim2.fromOffset(150, 28),
        Position = config.Position or UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = config.ZIndex or 100
    })
    
    local mainBtn = createBaseElement("TextButton", container, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.bg,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Text = self:GetLocalized(selected),
        TextColor3 = theme.text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 101,
        AutoButtonColor = false
    })
    
    self:CreateCorner(mainBtn, 4)
    
    local arrow = createBaseElement("TextLabel", mainBtn, {
        Size = UDim2.new(0, 30, 1, 0),
        Position = UDim2.new(1, -30, 0, 0),
        BackgroundTransparency = 1,
        Text = "▼",
        TextColor3 = theme.textDim,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 102
    })
    
    local list = createBaseElement("Frame", container, {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 1, 2),
        BackgroundColor3 = theme.surface,
        BackgroundTransparency = 0.95,
        BorderSizePixel = 1,
        BorderColor3 = theme.textDim,
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 200
    })
    
    self:CreateCorner(list, 4)
    
    local listLayout = createBaseElement("UIListLayout", list, {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder
    })
    
    local isOpen = false
    local optionButtons = {}
    
    local function buildOptions()
        for _, btn in ipairs(optionButtons) do
            btn:Destroy()
        end
        optionButtons = {}
        
        for i, option in ipairs(options) do
            local optBtn = createBaseElement("TextButton", list, {
                Size = UDim2.new(1, -8, 0, 28),
                Position = UDim2.new(0, 4, 0, 0),
                BackgroundTransparency = 0,
                BackgroundColor3 = (i % 2 == 0) and theme.surface or theme.surface2 or theme.bg,
                BorderSizePixel = 0,
                Text = self:GetLocalized(option),
                TextColor3 = theme.text,
                TextSize = 14,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                ZIndex = 201,
                AutoButtonColor = false,
                LayoutOrder = i
            })
            
            self:CreateCorner(optBtn, 2)
            
            optBtn.MouseEnter:Connect(function()
                optBtn.BackgroundColor3 = theme.primary
                optBtn.BackgroundTransparency = 0.3
            end)
            
            optBtn.MouseLeave:Connect(function()
                optBtn.BackgroundColor3 = (i % 2 == 0) and theme.surface or theme.surface2 or theme.bg
                optBtn.BackgroundTransparency = 0
            end)
            
            optBtn.MouseButton1Click:Connect(function()
                selected = option
                mainBtn.Text = self:GetLocalized(option)
                if config.OnSelect then
                    config.OnSelect(option)
                end
                toggleDropdown()
            end)
            
            table.insert(optionButtons, optBtn)
        end
        
        local totalHeight = #options * 30 + 4
        list.Size = UDim2.new(1, 0, 0, totalHeight)
    end
    
    local function toggleDropdown()
        isOpen = not isOpen
        list.Visible = isOpen
        
        if isOpen then
            arrow.Text = "▲"
            buildOptions()
            local targetHeight = #options * 30 + 4
            list.Size = UDim2.new(1, 0, 0, 0)
            self:Animate(list, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.2)
        else
            arrow.Text = "▼"
            local currentHeight = list.Size.Y.Offset
            self:Animate(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.15, nil, function()
                list.Visible = false
            end)
        end
    end
    
    mainBtn.MouseButton1Click:Connect(toggleDropdown)
    
    -- Close dropdown when clicking elsewhere
    if UserInputService then
        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and isOpen then
                local mousePos = UserInputService:GetMouseLocation()
                local containerPos = container.AbsolutePosition
                local containerSize = container.AbsoluteSize
                
                if not (mousePos.X >= containerPos.X and mousePos.X <= containerPos.X + containerSize.X and
                       mousePos.Y >= containerPos.Y and mousePos.Y <= containerPos.Y + containerSize.Y) then
                    toggleDropdown()
                end
            end
        end)
    end
    
    local dropdownData = {
        Instance = container,
        UpdateTheme = function(self)
            local newTheme = self.Parent and self.Parent:GetTheme() or theme
            mainBtn.BackgroundColor3 = newTheme.bg
            mainBtn.TextColor3 = newTheme.text
            arrow.TextColor3 = newTheme.textDim
            list.BackgroundColor3 = newTheme.surface
            list.BorderColor3 = newTheme.textDim
            
            for _, btn in ipairs(optionButtons) do
                if btn then
                    btn.TextColor3 = newTheme.text
                    btn.BackgroundColor3 = newTheme.surface
                end
            end
        end,
        GetSelected = function(self)
            return selected
        end,
        SetOptions = function(self, newOptions)
            options = newOptions
            if #options > 0 then
                selected = config.Default or options[1]
                mainBtn.Text = self:GetLocalized(selected)
                if config.OnSelect then
                    config.OnSelect(selected)
                end
                buildOptions()
            end
        end,
        Select = function(self, option)
            for _, opt in ipairs(options) do
                if opt == option then
                    selected = option
                    mainBtn.Text = self:GetLocalized(option)
                    if config.OnSelect then
                        config.OnSelect(option)
                    end
                    if isOpen then toggleDropdown() end
                    return true
                end
            end
            return false
        end
    }
    
    dropdownData.Parent = self
    
    return dropdownData
end

-- ============================================
-- NOTIFICATION CREATION
-- ============================================
function Nexus:CreateNotify(config)
    if not self._frame then
        self:Init()
    end
    
    local theme = self:GetTheme()
    local content = self:GetLocalized(config.Content or "Notification")
    
    local notif = createBaseElement("Frame", self._frame, {
        Size = config.Size or UDim2.fromOffset(320, 50),
        Position = UDim2.new(1, -340, 0, 20 + #self._notifications * 60),
        BackgroundColor3 = theme.surface,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ZIndex = 999,
        ClipsDescendants = true
    })
    
    self:CreateCorner(notif, 6)
    self:CreateShadow(notif, 8, 0.3)
    
    -- Icon (optional)
    if config.Icon then
        local icon = createBaseElement("TextLabel", notif, {
            Size = UDim2.new(0, 30, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = config.Icon,
            TextColor3 = config.IconColor or theme.primary,
            TextSize = 20,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 1000
        })
    end
    
    local label = createBaseElement("TextLabel", notif, {
        Size = UDim2.new(1, -(config.Icon and 50 or 20), 1, 0),
        Position = UDim2.new(0, config.Icon and 45 or 10, 0, 0),
        BackgroundTransparency = 1,
        Text = content,
        TextColor3 = theme.text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 1000
    })
    
    -- Title (optional)
    if config.Title then
        local titleText = self:GetLocalized(config.Title)
        label.Size = UDim2.new(1, -(config.Icon and 50 or 20), 0, 20)
        label.Position = UDim2.new(0, config.Icon and 45 or 10, 0, 5)
        label.Text = titleText
        label.TextSize = 12
        label.TextColor3 = theme.textDim
        label.Font = Enum.Font.GothamBold
        
        local subLabel = createBaseElement("TextLabel", notif, {
            Size = UDim2.new(1, -(config.Icon and 50 or 20), 0, 20),
            Position = UDim2.new(0, config.Icon and 45 or 10, 0, 25),
            BackgroundTransparency = 1,
            Text = content,
            TextColor3 = theme.text,
            TextSize = 14,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 1000
        })
    end
    
    table.insert(self._notifications, notif)
    
    -- Slide in animation
    notif.Position = UDim2.new(1, 0, 0, 20 + (#self._notifications - 1) * 60)
    notif.BackgroundTransparency = 1
    
    self:Animate(notif, {
        Position = UDim2.new(1, -340, 0, 20 + (#self._notifications - 1) * 60),
        BackgroundTransparency = 0.1
    }, 0.4)
    
    -- Auto remove
    local duration = config.Duration or 3
    task.wait(duration)
    
    self:Animate(notif, {
        Position = UDim2.new(1, 0, 0, 20 + (#self._notifications - 1) * 60),
        BackgroundTransparency = 1
    }, 0.3, nil, function()
        notif:Destroy()
        for i, n in ipairs(self._notifications) do
            if n == notif then
                table.remove(self._notifications, i)
                break
            end
        end
    end)
    
    return notif
end

-- ============================================
-- POPUP CREATION
-- ============================================
function Nexus:CreatePopup(config)
    if not self._frame then
        self:Init()
    end
    
    local theme = self:GetTheme()
    
    local overlay = createBaseElement("Frame", self._frame, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.5,
        ZIndex = 999,
        Visible = true
    })
    
    local popup = createBaseElement("Frame", overlay, {
        Size = config.Size or UDim2.fromOffset(400, 200),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.surface,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 1000
    })
    
    self:CreateCorner(popup, config.CornerRadius or 8)
    self:CreateShadow(popup, 32, 0.5)
    
    local titleText = self:GetLocalized(config.Title or "Popup")
    
    local title = createBaseElement("TextLabel", popup, {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = theme.text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 1001
    })
    
    local contentText = self:GetLocalized(config.Content or "Popup content here")
    
    local content = createBaseElement("TextLabel", popup, {
        Size = UDim2.new(1, -20, 0, 60),
        Position = UDim2.new(0, 10, 0, 55),
        BackgroundTransparency = 1,
        Text = contentText,
        TextColor3 = theme.textDim,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 1001,
        TextWrapped = true,
        TextScaled = false,
        ClipsDescendants = true
    })
    
    -- Close button (X)
    local closeBtn = createBaseElement("TextButton", popup, {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -36, 0, 6),
        BackgroundTransparency = 1,
        Text = "✕",
        TextColor3 = theme.textDim,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 1002
    })
    
    closeBtn.MouseButton1Click:Connect(function()
        if config.OnClose then
            config.OnClose()
        end
        overlay:Destroy()
    end)
    
    -- Buttons
    local buttons = config.Buttons or {}
    local btnWidth = config.ButtonWidth or 100
    local totalWidth = #buttons * (btnWidth + 10) - 10
    local startX = (popup.Size.X.Offset - totalWidth) / 2
    
    for i, btnConfig in ipairs(buttons) do
        local btnText = self:GetLocalized(btnConfig.Title or "Button")
        local isPrimary = btnConfig.Variant == "Primary" or i == #buttons
        
        local btn = self:CreateButton({
            Text = btnText,
            Size = UDim2.fromOffset(btnWidth, 32),
            Position = UDim2.new(0, startX + (i-1) * (btnWidth + 10), 1, -45),
            Color = isPrimary and theme.primary or theme.bg,
            HoverColor = isPrimary and theme.primaryHover or theme.surface2,
            Callback = function()
                if btnConfig.Callback then
                    btnConfig.Callback()
                end
                if btnConfig.CloseOnClick ~= false then
                    overlay:Destroy()
                end
            end
        })
        btn.Instance.Parent = popup
    end
    
    -- Click outside to close (optional)
    if config.CloseOnClickOutside ~= false then
        overlay.MouseButton1Click:Connect(function(input)
            -- Check if click was on overlay (not on popup)
            local popupPos = popup.AbsolutePosition
            local popupSize = popup.AbsoluteSize
            
            if not (input.Position.X >= popupPos.X and input.Position.X <= popupPos.X + popupSize.X and
                   input.Position.Y >= popupPos.Y and input.Position.Y <= popupPos.Y + popupSize.Y) then
                overlay:Destroy()
            end
        end)
    end
    
    table.insert(self._popups, overlay)
    
    return overlay
end

-- ============================================
-- TOGGLE SWITCH CREATION
-- ============================================
function Nexus:CreateToggle(config)
    config = config or {}
    local theme = self:GetTheme()
    local state = config.Default or false
    
    local container = createBaseElement("Frame", nil, {
        Size = config.Size or UDim2.fromOffset(160, 30),
        Position = config.Position or UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = config.ZIndex or 100
    })
    
    local label = createBaseElement("TextLabel", container, {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = self:GetLocalized(config.Text or "Toggle"),
        TextColor3 = theme.text,
        TextSize = config.TextSize or 14,
        Font = config.Font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 101
    })
    
    local track = createBaseElement("Frame", container, {
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -45, 0, 4),
        BackgroundColor3 = state and theme.primary or theme.bg,
        BackgroundTransparency = state and 0 or 0.5,
        BorderSizePixel = 0,
        ZIndex = 101
    })
    
    self:CreateCorner(track, 11)
    
    local thumb = createBaseElement("Frame", track, {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(state and 1 or 0, state and -20 or 2, 0, 2),
        BackgroundColor3 = theme.text,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ZIndex = 102
    })
    
    self:CreateCorner(thumb, 9)
    
    -- Click area
    local clickArea = createBaseElement("TextButton", container, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 103,
        AutoButtonColor = false
    })
    
    local function toggle()
        state = not state
        track.BackgroundColor3 = state and theme.primary or theme.bg
        track.BackgroundTransparency = state and 0 or 0.5
        
        self:Animate(thumb, {
            Position = UDim2.new(state and 1 or 0, state and -20 or 2, 0, 2)
        }, 0.15)
        
        if config.OnToggle then
            config.OnToggle(state)
        end
    end
    
    clickArea.MouseButton1Click:Connect(toggle)
    track.MouseButton1Click:Connect(toggle)
    label.MouseButton1Click:Connect(toggle)
    
    local toggleData = {
        Instance = container,
        UpdateTheme = function(self)
            local newTheme = self.Parent and self.Parent:GetTheme() or theme
            track.BackgroundColor3 = state and newTheme.primary or newTheme.bg
            label.TextColor3 = newTheme.text
        end,
        Toggle = function(self)
            toggle()
        end,
        SetState = function(self, newState)
            state = newState
            track.BackgroundColor3 = state and theme.primary or theme.bg
            track.BackgroundTransparency = state and 0 or 0.5
            thumb.Position = UDim2.new(state and 1 or 0, state and -20 or 2, 0, 2)
            if config.OnToggle then
                config.OnToggle(state)
            end
        end,
        GetState = function(self)
            return state
        end
    }
    
    toggleData.Parent = self
    
    return toggleData
end

-- ============================================
-- KEY SYSTEM UI (Helper)
-- ============================================
function Nexus:CreateKeySystemUI(config)
    config = config or {}
    local theme = self:GetTheme()
    
    local popup = self:CreatePopup({
        Title = config.Title or "Key System",
        Content = config.Content or "Please enter your license key to continue.",
        Size = config.Size or UDim2.fromOffset(420, 280),
        CloseOnClickOutside = false,
        Buttons = {}
    })
    
    -- Find the popup content
    local popupFrame = popup:FindFirstChildWhichIsA("Frame")
    if not popupFrame then return nil end
    
    -- Input field
    local keyInput = self:CreateInput({
        Size = UDim2.fromOffset(300, 32),
        Position = UDim2.new(0, 60, 0, 100),
        Placeholder = "Enter your key...",
        ClearOnFocus = false
    })
    keyInput.Instance.Parent = popupFrame
    
    -- Status label
    local statusLabel = self:CreateLabel({
        Text = "",
        TextSize = 12,
        Position = UDim2.new(0, 60, 0, 150)
    })
    statusLabel.Instance.Parent = popupFrame
    
    -- Validate button
    local validateBtn = self:CreateButton({
        Text = "Validate",
        Position = UDim2.new(0, 60, 0, 185),
        Size = UDim2.fromOffset(120, 32),
        Callback = function()
            local key = keyInput:GetText()
            if key == "" then
                statusLabel:SetText("Please enter a key")
                return
            end
            
            local providerName = config.Provider or "default"
            local isValid, message = self:CheckKey(key, providerName)
            
            if isValid then
                statusLabel:SetText("✓ " .. (message or "Key validated!"))
                statusLabel.Instance.TextColor3 = theme.success
                
                if config.OnSuccess then
                    config.OnSuccess(key)
                end
                
                task.wait(1)
                popup:Destroy()
            else
                statusLabel:SetText("✗ " .. (message or "Invalid key"))
                statusLabel.Instance.TextColor3 = theme.danger
                
                if config.OnFailure then
                    config.OnFailure(key, message)
                end
            end
        end
    })
    validateBtn.Instance.Parent = popupFrame
    
    return popup
end

