function NovaUI.LoadingSpinner(parent, config)
    config = config or {}
    local container = Instance.new("Frame")
    container.Size = config.Size or UDim2.new(0.1, 0, 0.1, 0)
    container.Position = config.Position or UDim2.new(0.45, 0, 0.45, 0)
    container.BackgroundTransparency = 1
