-- WINDOW CREATION
-- ============================================
function Nexus:CreateWindow(config)
    config = config or {}
    local theme = self:GetTheme()
    
    if not self._frame then
        self:Init()
    end
    
    local window = createBaseElement("Frame", self._frame, {
        Size = config.Size or UDim2.fromOffset(500, 400),
        Position = config.Position or UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.surface,
        BackgroundTransparency = config.Transparency or 0,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = true,
        ZIndex = 100
    })
    
    self:CreateCorner(window, config.CornerRadius or 8)
    
    if config.Shadow ~= false then
        self:CreateShadow(window)
    end
    
    local titleBar = createBaseElement("Frame", window, {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = theme.bg,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        ZIndex = 101
    })
    
    local titleText = self:GetLocalized(config.Title or "Nexus UI")
    
    local titleLabel = createBaseElement("TextLabel", titleBar, {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        ZIndex = 102
    })
    
    local closeBtn = createBaseElement("TextButton", titleBar, {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -36, 0, 3),
        BackgroundTransparency = 1,
        Text = "✕",
        TextColor3 = theme.textDim,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 102
    })
    
    closeBtn.MouseButton1Click:Connect(function()
        if config.OnClose then
            config.OnClose()
        end
        self:DestroyWindow(window)
    end)
    
    local content = createBaseElement("Frame", window, {
        Size = UDim2.new(1, -16, 1, -52),
        Position = UDim2.new(0, 8, 0, 42),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 100
    })
    
    if config.Draggable ~= false then
        pcall(function()
            local dragging = false
            local dragStart
            local startPos
            
            titleBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    dragStart = input.Position
                    startPos = window.Position
                end
            end)
            
            titleBar.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            titleBar.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = input.Position - dragStart
                    window.Position = UDim2.new(
                        startPos.X.Scale,
                        startPos.X.Offset + delta.X,
                        startPos.Y.Scale,
                        startPos.Y.Offset + delta.Y
                    )
                end
            end)
        end)
    end
    
    local windowData = {
        Instance = window,
        Content = content,
        TitleBar = titleBar,
        Title = titleLabel,
        Close = closeBtn,
        Elements = {},
        Tabs = {},
        Config = config,
        Parent = self,
        _currentTab = nil,
        
        Add = function(self, element)
            if not element then return end
            element.Parent = content
            table.insert(self.Elements, element)
            return element
        end,
        
        AddTab = function(self, tabConfig)
            local tabData = self.Parent:CreateTab(self, tabConfig)
            table.insert(self.Tabs, tabData)
            
            if not self._currentTab then
                self:SelectTab(#self.Tabs)
            end
            
            return tabData
        end,
        
        SelectTab = function(self, index)
            if type(index) == "string" then
                for i, tab in ipairs(self.Tabs) do
                    if tab.Name == index then
                        index = i
                        break
                    end
                end
            end
            
            if type(index) ~= "number" or index < 1 or index > #self.Tabs then
                return
            end
            
            self._currentTab = index
            
            for i, tab in ipairs(self.Tabs) do
                if tab.Instance then
                    tab.Instance.Visible = (i == index)
                    tab.Instance.ZIndex = (i == index) and 100 or 1
                end
                if tab.Button then
                    tab.Button.BackgroundColor3 = (i == index) and theme.primary or theme.bg
                    tab.Button.BackgroundTransparency = (i == index) and 0 or 0.5
                end
            end
            
            if self.Tabs[index] and self.Tabs[index].OnSelect then
                self.Tabs[index]:OnSelect()
            end
        end,
        
        UpdateTheme = function(self)
            local newTheme = self.Parent:GetTheme()
            if not newTheme then return end
            
            window.BackgroundColor3 = newTheme.surface
            titleBar.BackgroundColor3 = newTheme.bg
            titleLabel.TextColor3 = newTheme.text
            closeBtn.TextColor3 = newTheme.textDim
            
            for _, element in ipairs(self.Elements) do
                if element and element.UpdateTheme then
                    element:UpdateTheme()
                end
            end
            
            for _, tab in ipairs(self.Tabs) do
                if tab and tab.UpdateTheme then
                    tab:UpdateTheme()
                end
            end
        end,
        
        Destroy = function(self)
            self.Parent:DestroyWindow(window)
        end
    }
    
    -- Create tabs if provided
    if config.Tabs then
        for _, tabConfig in ipairs(config.Tabs) do
            windowData:AddTab(tabConfig)
        end
        if #windowData.Tabs > 0 then
            windowData:SelectTab(1)
        end
    end
    
    table.insert(self._windows, windowData)
    
    if self._debug then
        print("[Nexus] Window created:", config.Title)
    end
    
    return windowData
end

function Nexus:DestroyWindow(windowInstance)
    if not windowInstance then return end
    
    if windowInstance.Instance then
        windowInstance = windowInstance.Instance
    end
    
    if windowInstance and windowInstance.Parent then
        windowInstance:Destroy()
    end
    
    for i = #self._windows, 1, -1 do
        if self._windows[i].Instance == windowInstance or self._windows[i].Instance == nil then
            table.remove(self._windows, i)
        end
    end
end

-- ============================================
-- TAB CREATION
-- ============================================
function Nexus:CreateTab(window, config)
    local theme = self:GetTheme()
    local tabName = config.Name or "Tab" .. tostring(#window.Tabs + 1)
    
    -- Tab button in the title bar area
    local tabButton = createBaseElement("TextButton", window.TitleBar, {
        Size = UDim2.new(0, 80, 0, 28),
        Position = UDim2.new(0, 80 + (#window.Tabs * 86), 0, 4),
        BackgroundColor3 = theme.bg,
        BackgroundTransparency = 0.5,
        Text = self:GetLocalized(tabName),
        TextColor3 = theme.textDim,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0,
        ZIndex = 102,
        AutoButtonColor = false
    })
    
    self:CreateCorner(tabButton, 4)
    
    -- Tab content container (hidden by default)
    local tabContent = createBaseElement("Frame", window.Content, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 1,
        ClipsDescendants = true
    })
    
    -- Create a scrolling frame if content is expected to be large
    local scrollFrame = createBaseElement("ScrollingFrame", tabContent, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        VerticalScrollBarPosition = Enum.VerticalScrollBarPosition.Right,
        BorderSizePixel = 0,
        ZIndex = 100,
        ClipsDescendants = true
    })
    
    -- Content layout for the tab
    local contentLayout = createBaseElement("UIListLayout", scrollFrame, {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    })
    
    -- Build tab content if provided
    local tabData = {
        Name = tabName,
        Instance = tabContent,
        Button = tabButton,
        ScrollFrame = scrollFrame,
        Layout = contentLayout,
        Window = window,
        Parent = self,
        Elements = {},
        
        Add = function(self, element)
            if not element then return end
            element.Parent = scrollFrame
            table.insert(self.Elements, element)
            
            -- Update canvas size
            local function updateCanvas()
                local totalHeight = 0
                for _, child in ipairs(scrollFrame:GetChildren()) do
                    if child:IsA("GuiObject") and child.Visible then
                        totalHeight = totalHeight + child.Size.Y.Offset + 6
                    end
                end
                scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 20)
            end
            
            -- Update canvas when elements change
            if element.Instance and element.Instance:IsA("GuiObject") then
                element.Instance:GetPropertyChangedSignal("Size"):Connect(updateCanvas)
                element.Instance:GetPropertyChangedSignal("Visible"):Connect(updateCanvas)
            end
            
            task.wait(0.05)
            updateCanvas()
            
            return element
        end,
        
        OnSelect = function(self)
            if config.OnSelect then
                config.OnSelect()
            end
        end,
        
        UpdateTheme = function(self)
            local newTheme = self.Parent:GetTheme()
            if not newTheme then return end
            
            tabButton.TextColor3 = (self.Window._currentTab == self.Window.Tabs[self]) and newTheme.text or newTheme.textDim
            tabButton.BackgroundColor3 = (self.Window._currentTab == self.Window.Tabs[self]) and newTheme.primary or newTheme.bg
            tabButton.BackgroundTransparency = (self.Window._currentTab == self.Window.Tabs[self]) and 0 or 0.5
            
            for _, element in ipairs(self.Elements) do
                if element and element.UpdateTheme then
                    element:UpdateTheme()
                end
            end
        end,
        
        Select = function(self)
            self.Window:SelectTab(self)
        end
    }
    
    tabButton.MouseButton1Click:Connect(function()
        tabData:Select()
    end)
    
    -- Execute the content builder if provided
    if config.Content then
        local success, err = pcall(function()
            config.Content(tabData)
        end)
        if not success and self._debug then
            warn("[Nexus] Tab content error:", err)
        end
    end
    
    return tabData
end

