-- ============================================
-- TAB SYSTEM
-- ============================================
function NovaUI.Tabs(parent, tabs, config)
    config = config or {}
    local tabContainer = Instance.new("Frame")
    tabContainer.Size = config.Size or UDim2.new(1, 0, 1, 0)
    tabContainer.BackgroundTransparency = 1
    tabContainer.Parent = parent
    
    local tabButtons = {}
    local tabContents = {}
    local activeTab = nil
    
    -- Create tab buttons at top
    local buttonFrame = Instance.new("Frame")
    buttonFrame.Size = UDim2.new(1, 0, 0.1, 0)
    buttonFrame.BackgroundTransparency = 1
    buttonFrame.Parent = tabContainer
    
    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(1, 0, 0.9, 0)
    contentFrame.Position = UDim2.new(0, 0, 0.1, 0)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = tabContainer
    
    local buttonWidth = 1 / #tabs
    
    for i, tab in ipairs(tabs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(buttonWidth - 0.02, 0, 1, 0)
        btn.Position = UDim2.new((i-1) * buttonWidth + 0.01, 0, 0, 0)
        btn.BackgroundColor3 = config.ButtonColor or Color3.new(0.157, 0.157, 0.235)
        btn.BackgroundTransparency = config.ButtonTransparency or 0.3
        btn.BorderSizePixel = 0
        btn.Text = tab.name or "Tab " .. i
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = config.TextSize or 16
        btn.Font = Enum.Font.GothamBold
        btn.Parent = buttonFrame
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn
        
        -- Content for this tab
        local content = Instance.new("Frame")
        content.Size = UDim2.new(1, 0, 1, 0)
        content.BackgroundTransparency = 1
        content.Visible = false
        content.Parent = contentFrame
        
        -- Store
        table.insert(tabButtons, btn)
        table.insert(tabContents, content)
        
        btn.MouseButton1Click:Connect(function()
            for j, b in ipairs(tabButtons) do
                b.BackgroundColor3 = config.ButtonColor or Color3.new(0.157, 0.157, 0.235)
                b.BackgroundTransparency = config.ButtonTransparency or 0.3
                tabContents[j].Visible = false
            end
            btn.BackgroundColor3 = config.ActiveColor or Color3.new(0.118, 0.565, 1)
            btn.BackgroundTransparency = 0
            content.Visible = true
            activeTab = i
        end)
    end
    
    -- Activate first tab
    if #tabButtons > 0 then
        tabButtons[1].BackgroundColor3 = config.ActiveColor or Color3.new(0.118, 0.565, 1)
        tabButtons[1].BackgroundTransparency = 0
        tabContents[1].Visible = true
        activeTab = 1
    end
    
    return {
        Container = tabContainer,
        ContentFrame = contentFrame,
        TabContents = tabContents,
        TabButtons = tabButtons,
        GetActiveTab = function() return activeTab end,
        SwitchTab = function(index)
            if tabButtons[index] then
                tabButtons[index].MouseButton1Click:Fire()
            end
        end
    }
end

