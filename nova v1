    spinner.BackgroundTransparency = 1
    spinner.Image = "rbxassetid://0"
    spinner.ImageColor3 = config.Color or Color3.new(1, 0.784, 0.196)
    spinner.Parent = container
    
    -- Create rotating circle using a frame with corner radius
    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0.8, 0, 0.8, 0)
    circle.Position = UDim2.new(0.1, 0, 0.1, 0)
    circle.BackgroundColor3 = config.Color or Color3.new(1, 0.784, 0.196)
    circle.BackgroundTransparency = 0.8
