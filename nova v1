-- Create a Button
function NovaUI.Button(text, onClick, config)
    config = config or {}
    local btn = Instance.new("TextButton")
    btn.Size = config.Size or UDim2.new(0.3, 0, 0.12, 0)
    btn.Position = config.Position or UDim2.new(0.35, 0, 0.44, 0)
    btn.BackgroundColor3 = config.BackgroundColor3 or Color3.new(0.118, 0.565, 1)
    btn.BackgroundTransparency = config.BackgroundTransparency or 0
    btn.BorderSizePixel = config.BorderSizePixel or 0
    btn.Text = text or "Button"
    btn.TextColor3 = config.TextColor3 or Color3.new(1, 1, 1)
    btn.TextSize = config.TextSize or 18
    btn.Font = config.Font or Enum.Font.GothamBold
    btn.TextScaled = config.TextScaled or false
    btn.AutoButtonColor = false
    btn.ClipsDescendants = true
    
    if config.CornerRadius then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = config.CornerRadius
        corner.Parent = btn
    end
    
    -- Hover effects
    local defaultColor = btn.BackgroundColor3
    local hoverColor = config.HoverColor or Color3.new(0.235, 0.667, 1)
    local clickColor = config.ClickColor or Color3.new(0, 0.314, 0.784)
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = hoverColor
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = defaultColor
    end)
    
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = clickColor
        if onClick then
            pcall(onClick, btn)
        end
        task.wait(0.1)
        btn.BackgroundColor3 = defaultColor
    end)
    
    return btn
end

-- Create an Input Box
function NovaUI.Input(placeholder, onChange, config)
    config = config or {}
    local input = Instance.new("TextBox")
    input.Size = config.Size or UDim2.new(0.8, 0, 0.1, 0)
    input.Position = config.Position or UDim2.new(0.1, 0, 0.2, 0)
    input.BackgroundColor3 = config.BackgroundColor3 or Color3.new(0.157, 0.157, 0.196)
    input.BackgroundTransparency = config.BackgroundTransparency or 0
    input.BorderSizePixel = config.BorderSizePixel or 2
    input.BorderColor3 = config.BorderColor3 or Color3.new(0.275, 0.275, 0.353)
    input.Text = ""
    input.PlaceholderText = placeholder or "Type here..."
    input.TextColor3 = config.TextColor3 or Color3.new(1, 1, 1)
    input.PlaceholderColor3 = config.PlaceholderColor3 or Color3.new(0.588, 0.588, 0.588)
    input.TextSize = config.TextSize or 16
    input.Font = config.Font or Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.ClipsDescendants = true
    
    if config.CornerRadius then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = config.CornerRadius
        corner.Parent = input
    end
    
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed and onChange then
            pcall(onChange, input, input.Text)
        end
    end)
    
    input.Changed:Connect(function(prop)
        if prop == "Text" and onChange then
            pcall(onChange, input, input.Text)
        end
    end)
    
    return input
end

